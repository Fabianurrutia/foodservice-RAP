{
  "name": "foodservice",
  "version": "1.0.0",
  "description": "FoodService - plataforma de reservas y calificación de restaurantes con pruebas automatizadas y CI/CD",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "node server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "test:backend": "jest --runInBand --verbose",
    "test:frontend": "cypress run",
    "cy:open": "cypress open"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.10.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "cypress": "^13.17.0",
    "jest": "^29.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "supertest": "^7.0.0",
    "vite": "^5.4.14",
    "wait-on": "^8.0.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/backend/**/*.test.js"
    ]
  }
}
